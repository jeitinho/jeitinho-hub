{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jeitinho-hub",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat_v2"],
  "main": "./src/server.ts",
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jeitinho-hub",
      "database_id": "c363efd5-8b79-4d0f-b23c-1eb327ee1c0f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jeitinho-hub-media"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}
