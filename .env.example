# Supabase / Lovable Cloud — client (exposé au navigateur)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase — serveur (server functions / SSR)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Ne PAS committer : service role, bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé entre le déploiement Cloudflare et le déploiement Lovable.
# Ne PAS committer la vraie valeur.
INTERNAL_PROCESS_SECRET=

# Lovable AI Gateway
LOVABLE_API_KEY=

# Setup initial admin (route /setup)
SETUP_KEY=

# GitHub (connecteur Lovable — publication blog vers rio-uncovered)
GITHUB_API_KEY=

# Ingestion des leads écosystème (POST /api/public/leads) — même valeur
# côté jeitinho.fr dans JEITINHO_HUB_LEADS_SECRET. Ne PAS committer la
# vraie valeur. Générer avec: openssl rand -hex 32
LEADS_INGEST_SECRET=