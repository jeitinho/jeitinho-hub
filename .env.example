# Supabase / client (exposé au navigateur)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase — serveur (server functions / SSR)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Ne PAS committer : service role, bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# Lovable AI Gateway (autres fonctionnalités éventuelles)
LOVABLE_API_KEY=

# OpenRouter — serveur uniquement, jamais VITE_
OPENROUTER_API_KEY=
# Modèle gratuit par défaut ; peut être remplacé par un modèle OpenRouter compatible tools.
OPENROUTER_MODEL=openrouter/free
# Métadonnées facultatives envoyées à OpenRouter
OPENROUTER_SITE_URL=https://jeitinho.fr
OPENROUTER_APP_NAME=JEITINHO Hub

# Setup initial admin (route /setup)
SETUP_KEY=

# GitHub (publication blog vers rio-uncovered)
GITHUB_API_KEY=

# Ingestion des leads écosystème (POST /api/public/leads) — même valeur
# côté jeitinho.fr dans JEITINHO_HUB_LEADS_SECRET. Ne PAS committer la
# vraie valeur. Générer avec: openssl rand -hex 32
LEADS_INGEST_SECRET=
