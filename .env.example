# Supabase / client (exposé au navigateur)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase — serveur (server functions / SSR)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Ne PAS committer : service role, bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# Lovable AI Gateway (autres fonctionnalités éventuelles)
LOVABLE_API_KEY=

# Gemini — serveur uniquement, jamais VITE_
# Créer la clé dans Google AI Studio.
GEMINI_API_KEY=
# Modèle agent gratuit par défaut ; peut être remplacé par un autre modèle Gemini disponible.
GEMINI_AGENT_MODEL=gemini-2.5-flash-lite

# Setup initial admin (route /setup)
SETUP_KEY=

# GitHub (publication blog vers rio-uncovered)
GITHUB_API_KEY=

# Ingestion des leads écosystème (POST /api/public/leads) — même valeur
# côté jeitinho.fr dans JEITINHO_HUB_LEADS_SECRET. Ne PAS committer la
# vraie valeur. Générer avec: openssl rand -hex 32
LEADS_INGEST_SECRET=
