# Supabase — client (exposé au navigateur)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase — serveur (server functions / SSR / catalog gateway)
SUPABASE_URL=
SUPABASE_PROJECT_ID=
# Recommandé : nouvelle clé secrète Supabase (sb_secret_...). Serveur uniquement.
# Ne jamais préfixer par VITE_ et ne jamais committer la vraie valeur.
SUPABASE_SECRET_KEY=
# Legacy fallback uniquement : service_role JWT. Ne jamais exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Lovable AI Gateway
LOVABLE_API_KEY=

# Setup initial admin (route /setup)
SETUP_KEY=

# GitHub (publication blog vers rio-uncovered)
GITHUB_API_KEY=

# Ingestion des leads écosystème (POST /api/public/leads) — même valeur
# côté jeitinho.fr dans JEITINHO_HUB_LEADS_SECRET. Ne PAS committer la
# vraie valeur. Générer avec: openssl rand -hex 32
LEADS_INGEST_SECRET=
